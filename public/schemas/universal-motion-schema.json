{
  "$ref": "#/definitions/UniversalMotionSchemaV2",
  "definitions": {
    "UniversalMotionSchemaV2": {
      "type": "object",
      "properties": {
        "bgPreset": {
          "type": "string",
          "enum": [
            "SwissGridHUD",
            "CyberpunkMatrixBg",
            "IsometricGridBg",
            "ParticleTunnelBg",
            "QuantumWaveformBg",
            "HolographicBlueprintBg",
            "HyperdriveGridBg",
            "VolumetricFogHUD",
            "AnomalousNoiseField"
          ],
          "default": "SwissGridHUD"
        },
        "primaryColor": {
          "type": "string",
          "default": "#00E5FF"
        },
        "backgroundColor": {
          "type": "string",
          "default": "#050505"
        },
        "cameraZoomMin": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2,
          "multipleOf": 0.05,
          "default": 0.85
        },
        "cameraZoomMax": {
          "type": "number",
          "minimum": 1,
          "maximum": 3,
          "multipleOf": 0.05,
          "default": 1.65
        },
        "rotateXBaseDeg": {
          "type": "number",
          "minimum": -90,
          "maximum": 90,
          "multipleOf": 1,
          "default": 28
        },
        "dispersionMax": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5,
          "multipleOf": 0.01,
          "default": 0.12
        }
      },
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}